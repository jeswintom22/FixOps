# FixOps environment configuration
#
# Local (zero-dependency) mode is the default. Set LLM_PROVIDER to one of:
#   local, ollama, openai, azure_openai, azure_foundry

# Where FixOps stores its SQLite database.
# FIXOPS_DATA_DIR=/path/to/fixops/data

# LLM provider.
LLM_PROVIDER=local

# For ollama:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b

# For OpenAI-compatible APIs:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# API_KEY=sk-...

# For Azure OpenAI:
# LLM_PROVIDER=azure_openai
# ENDPOINT=https://<resource>.openai.azure.com
# API_KEY=...
# API_VERSION=2024-02-01
# LLM_MODEL=<chat-deployment>
# EMBEDDING_MODEL=<embedding-deployment>

# Optional API key for the server mode/UI.
# FIXOPS_API_KEY=change-me

# Server mode host/port.
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000

# CORS origins for the server mode (comma-separated).
# CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# Disable automatic secret/PII redaction before sending logs to cloud LLMs.
# REDACTION_ENABLED=false
